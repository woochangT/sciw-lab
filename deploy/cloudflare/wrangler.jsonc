{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sciw-lab-preview",
  "account_id": "b1657b0b72f2cb39b70cf6dd4f5f4431",
  "main": "runtime.mjs",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../.local/cloudflare-site",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{"binding":"DB","database_name":"sciw-records","database_id":"c99c8a86-720c-426e-9f54-c4746ad2b9d7"}],
  "durable_objects": {"bindings":[{"name":"PROGRESS","class_name":"ClassProgress"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["ClassProgress"]}],
  "ratelimits": [{"name":"TEACHER_LOGIN_LIMIT","namespace_id":"51719","simple":{"limit":8,"period":60}}],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
